/* Global Qt stylesheet: colours, fonts and widget styles for the whole app. */


/* -Prathams styles: */
QFrame#card {
    background-color: #f5a623;
    padding: 16px;
    border-radius: 8px;
    border: 1px solid #000000;
}

QProgressBar {
    background-color: #ffffff;
    border: none;
    border-radius: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #07da5e;
    border-radius: 6px;
}
QWidget#window{
    background-color: #ffffff;

}

QLabel#heading{
    color: #e6e6e6 ;
    font-size: 20px;
    
}

/* end of Prathams styles */